[Unit]
Description=Chuang dedicated Feishu bridge
# Keep this unit isolated from Codex/Hermes bridge units and credentials.
After=network-online.target chuang-agent-app-server.service
Wants=network-online.target chuang-agent-app-server.service

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/chuang-agent
EnvironmentFile=/absolute/path/to/chuang-feishu-bridge.env
ExecStart=/absolute/path/to/chuang-agent/scripts/chuang-feishu-bridge.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
