CHUANG_AGENT_ROOT=/absolute/path/to/chuang-agent
CHUANG_AGENT_WORKSPACE_ROOT=/absolute/path/to/chuang-agent
# This env file is Chuang-only. Do not mix Codex/Hermes credential names here.
# Provider key env stays outside the repo and outside Feishu credentials.
# The bridge script sources this file before connecting to the canonical app-server.
# Optional; omit to use ~/.config/chuang-agent/provider.env.
CHUANG_PROVIDER_ENV_FILE=/absolute/path/to/provider.env

# Desktop env is auto-detected by scripts/chuang-feishu-bridge.sh when possible.
# Set DISPLAY/XAUTHORITY/XDG_RUNTIME_DIR here only if auto-detection is wrong.

# Chuang dedicated Feishu app. Do not reuse Codex or Hermes credentials.
CHUANG_FEISHU_APP_ID=<set outside repository>
CHUANG_FEISHU_APP_SECRET=<set outside repository>
CHUANG_FEISHU_CONNECTION_MODE=websocket
CHUANG_FEISHU_ENCRYPT_KEY=<optional>
# Optional only if you later switch to a webhook-style adapter.
CHUANG_FEISHU_BOT_ID=<optional>
CHUANG_FEISHU_VERIFICATION_TOKEN=<optional>
