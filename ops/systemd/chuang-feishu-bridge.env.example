CHUANG_AGENT_ROOT=/home/user/projects/chuang-agent
CHUANG_AGENT_WORKSPACE_ROOT=/home/user/projects/chuang-agent
# Provider key env stays outside the repo and outside Feishu credentials.
# The bridge script will source this file before launching app-server.
CHUANG_PROVIDER_ENV_FILE=/home/user/.config/chuang-agent/provider.env

# Chuang dedicated Feishu app. Do not reuse Codex or Hermes credentials.
CHUANG_FEISHU_APP_ID=<set outside repository>
CHUANG_FEISHU_APP_SECRET=<set outside repository>
CHUANG_FEISHU_CONNECTION_MODE=websocket
CHUANG_FEISHU_ENCRYPT_KEY=<optional>
# Optional only if you later switch to a webhook-style adapter.
CHUANG_FEISHU_BOT_ID=<optional>
CHUANG_FEISHU_VERIFICATION_TOKEN=<optional>
