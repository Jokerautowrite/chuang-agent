{
  "units": [
    {
      "unit_id": "chuang-agent-app-server.service",
      "display_name": "Chuang App Server",
      "kind": "service",
      "default_status": "Stopped",
      "status_command": ["systemctl", "--user", "is-active", "chuang-agent-app-server.service"],
      "start_command": ["systemctl", "--user", "start", "chuang-agent-app-server.service"],
      "stop_command": ["systemctl", "--user", "stop", "chuang-agent-app-server.service"],
      "restart_command": ["systemctl", "--user", "restart", "chuang-agent-app-server.service"],
      "metadata": {
        "channel": "systemd-user",
        "owner": "chuang",
        "note": "Feishu bridge intentionally excluded from default allowlist"
      }
    }
  ]
}
